@@ -1229,10 +1231,28 @@
   // We prefer CCRandomGenerateBytes as it returns an error code while arc4random_buf
   // may fail silently on macOS. See PR #390, and <https://opensource.apple.com/source/Libc/Libc-1439.40.11/gen/FreeBSD/arc4random.c.auto.html>
   return (CCRandomGenerateBytes(buf, buf_len) == kCCSuccess);
+}
+
+#elif defined(__NetBSD__)
+
+#include <sys/sysctl.h>
+
+bool _mi_prim_random_buf(void* buf, size_t buf_len) {
+  // Use the `kern.arandom` sysctl instead of `arc4random_buf`: on NetBSD the first
+  // `arc4random_buf` call registers a fork handler with `pthread_atfork`, which calls `malloc`.
+  const int mib[2] = { CTL_KERN, KERN_ARND };
+  uint8_t* p = (uint8_t*)buf;
+  while (buf_len > 0) {
+    size_t len = (buf_len > 256 ? 256 : buf_len);  // at most 256 bytes per call
+    if (sysctl(mib, 2, p, &len, NULL, 0) != 0 || len == 0) return false;
+    p += len;
+    buf_len -= len;
+  }
+  return true;
 }
 
