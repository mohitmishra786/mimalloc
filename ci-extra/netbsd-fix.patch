@@ -683,6 +683,8 @@
   }
   #if defined(PROT_MAX)
   protect_flags |= PROT_MAX(PROT_READ | PROT_WRITE); // BSD
+  #elif defined(PROT_MPROTECT)
+  protect_flags |= PROT_MPROTECT(PROT_READ | PROT_WRITE); // NetBSD (PaX MPROTECT)
   #endif
   // huge page allocation
